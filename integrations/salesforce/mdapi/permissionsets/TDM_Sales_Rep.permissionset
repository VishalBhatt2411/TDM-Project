<?xml version="1.0" encoding="UTF-8"?>
<!--
  Field-facing sales rep access for the native Salesforce app.

  Deliberately does NOT grant viewAllRecords/modifyAllRecords on Booking__c — combined
  with Booking__c's Private org-wide default, that means a rep sees exactly the drives
  they own (are assigned) and nothing else. TDM_Full_Access is the opposite by design
  (it exists for the backend integration user) and must never be assigned to a rep.

  Catalog/reference data (vehicles, variants, branches) is intentionally readable
  org-wide and read-only: every rep needs the full lineup to talk to a customer, but
  nobody in the field should be editing inventory or dealership records from here.

  Not granted at all: Sales_Rep__c (retired object), Compliance_Record__c (licence
  scans/signatures — sensitive PII reps don't need in Salesforce), Drive_Feedback__c,
  Vehicle_Allocation__c, Wishlist_Item__c. Reps do that work in the TDM web app.
-->
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>TDM Sales Rep</label>
    <description>Sales rep access to the TDM app: read/edit only the test drives they own, read-only vehicle and branch reference data.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <objectPermissions>
        <object>Booking__c</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Vehicle__c</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Vehicle_Variant__c</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Branch__c</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

