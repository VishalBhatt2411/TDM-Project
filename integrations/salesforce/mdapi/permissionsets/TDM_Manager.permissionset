<?xml version="1.0" encoding="UTF-8"?>
<!--
  Branch/dealership manager: works bookings and cases, keeps stock status and odometer
  current, and can see who is on the team. Read-only on dealership, branch and catalog
  records; no access to feature flags or email template overrides. Dealership, branch, stock
  and booking visibility is limited to the manager's own dealership(s) by TdmRecordSharing,
  so View All is not granted on those objects.
-->
