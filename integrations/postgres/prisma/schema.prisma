generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Platform login credentials for a registered customer. The customer's business
// identity (name/email/phone/license) lives in Salesforce Contact; this table only
// holds what's needed to authenticate them against our own API.
model AuthCredential {
  customerId   String   @id
  passwordHash String
  // True for a system-generated password the customer never saw/chose (auto-registered
  // at booking time) — until they complete password setup, they have no real way back in
  // once a one-time magic link is used, so such accounts must always be offered password
  // setup instead of a magic link. Defaults true: unproven otherwise, safer to assume so.
  isTemporary  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model OtpCode {
  id         String   @id @default(uuid())
  customerId String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model RefreshToken {
  id         String    @id @default(uuid())
  customerId String
  tokenHash  String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
  @@unique([customerId, tokenHash])
}

// Tenant-scoped: every read and write filters by organizationId explicitly (see PostgresAuditLogRepository).
model AuditLogEntry {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String
  action         String
  entityType     String
  entityId       String
  /// The dealership (data-provider id) the change belongs to; null for a company-wide change.
  dealershipId   String?
  metadata       Json
  occurredAt     DateTime     @default(now())

  @@index([organizationId, occurredAt])
  @@index([organizationId, dealershipId, occurredAt])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, actorId])
}

// Tracks which scheduled reminders have already been sent for a booking, so the
// reminder cron job never double-sends when it re-scans the same time window.
model ReminderLog {
  id           String   @id @default(uuid())
  bookingId    String
  reminderType String // "24h" | "2h" | "day_of"
  sentAt       DateTime @default(now())

  @@unique([bookingId, reminderType])
}

// Tracks which no-purchase follow-up emails have already been sent per booking.
model FollowUpLog {
  id           String   @id @default(uuid())
  bookingId    String
  intervalDays Int
  sentAt       DateTime @default(now())

  @@unique([bookingId, intervalDays])
}

// One-click sign-in links emailed to customers whose account was auto-created
// during test-drive booking (see the booking flow) — avoids ever emailing a
// plaintext password.
model MagicLoginToken {
  id         String    @id @default(uuid())
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

// One-time-use links for customer password creation/reset — issued when a new
// account is auto-registered at booking time (see AuthService.issuePasswordSetupEmail)
// and reused for customer-initiated forgot-password requests. Same shape/semantics
// as StaffPasswordToken; kept separate since customers and staff are different
// identity spaces.
model CustomerPasswordToken {
  id         String    @id @default(uuid())
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

// Internal platform staff (Admin Console users) — entirely separate identity
// space from customers, but credentials are NOT stored here: a staff user
// authenticates with their actual Salesforce identity (OAuth2 Authorization
// Code flow — see AdminAuthService), and this table only governs what they can
// do once logged in (role/permissions), matched by email at login time.
// salesforceUserId is populated just-in-time on first successful login, for
// auditability — matching itself is by email, not this field.
// Every staff account belongs to exactly one tenant; email is unique per tenant only
// (the same person may legitimately be staff at two client companies).
model StaffUser {
  // Local identity only — roles and dealership access live in the business-data provider's
  // staff assignments and are re-read at authorization time (see StaffAccessService).
  id                String        @id @default(uuid())
  salesforceUserId  String
  email             String
  name              String
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Salesforce emails aren't unique within an org, so identity is keyed by the User id.
  @@unique([organizationId, salesforceUserId])
}

model StaffRefreshToken {
  id          String    @id @default(uuid())
  staffUserId String
  tokenHash   String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([staffUserId])
  @@unique([staffUserId, tokenHash])
}

// Server-side storage for a pending "Login with Salesforce" OAuth2/PKCE handshake.
// The browser only ever carries the opaque `state` id (CSRF token + lookup key);
// the PKCE code_verifier itself never leaves the server, keeping the redirect URL
// short and the verifier out of browser history/referrer headers. Single-use:
// consumed (deleted) by AdminAuthService on callback, whether or not it succeeds.
// Reused by OnboardingService for the tenant "Connect Salesforce" handshake — same
// single-use semantics, distinguished by `purpose` so a state minted for one flow can
// never be redeemed by the other's callback.
model StaffOAuthState {
  state          String       @id
  codeVerifier   String
  purpose        String // "staff_login" | "onboarding"
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  createdAt      DateTime      @default(now())

  @@index([organizationId])
}

// A client company connecting their own Salesforce org to this platform via the
// self-service onboarding wizard (see OnboardingService). Salesforce secrets are
// encrypted at rest (see crypto.ts) — never stored or logged in plaintext.
model Organization {
  id                   String    @id @default(uuid())
  name                 String
  // URL-safe company identifier (Admin Console login, and its TenantSubdomain label) —
  // validated lowercase-alphanumeric-with-hyphens at creation time (OnboardingService).
  slug                 String    @unique
  sfConsumerKey        String?
  sfConsumerSecretEnc  String? // AES-256-GCM, "iv:authTag:cipher" hex (see crypto.ts)
  sfRefreshTokenEnc    String?
  sfInstanceUrl        String?
  sfLoginUrl           String    @default("https://login.salesforce.com")
  sfOrgId              String?
  connectionStatus     String    @default("pending") // "pending" | "connected" | "error"
  connectionError      String?
  metadataDeployedAt   DateTime?
  // Bumped whenever the master encryption key is rotated, so a future migration
  // knows which key to decrypt sfConsumerSecretEnc/sfRefreshTokenEnc with.
  encryptionKeyVersion Int       @default(1)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  staffUsers  StaffUser[]
  oauthStates StaffOAuthState[]
  hosts       TenantHost[]
  subdomains  TenantSubdomain[]
  auditLog    AuditLogEntry[]
}

// Routes a company's or dealer's own custom domain to its tenant. Platform subdomains
// ("<label>.<TENANT_BASE_DOMAIN>") resolve through TenantSubdomain instead.
// Must live outside Salesforce: it decides *which* Salesforce org to talk to at all.
model TenantHost {
  hostname       String       @id // lowercase, no port
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Salesforce Dealership__c Id the domain serves; null = registered for the whole company.
  dealershipId   String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// Platform subdomain labels ("<label>.<TENANT_BASE_DOMAIN>"). Company slugs and dealer
// Url_Slug__c values share this one global namespace, so a label can never resolve to two
// tenants; dealer rows are synced from Salesforce Dealership__c (first registration wins).
model TenantSubdomain {
  label          String       @id // lowercase, validated against ORGANIZATION_SLUG_PATTERN
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Salesforce Dealership__c Id; null = the company's own label (its Organization.slug).
  dealershipId   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}
