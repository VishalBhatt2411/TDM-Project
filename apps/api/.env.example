# API environment. Copy to .env and fill in. Validated at boot by src/common/env.ts —
# the process refuses to start on a missing or weak value.

# "production" enforces https URLs and disables localhost fallbacks and API docs by default.
NODE_ENV=development
PORT=3000

# Platform store (tenants, sessions, audit log, encrypted Salesforce credentials).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/tdm?schema=public

# Signs staff/customer JWTs and derives custom-domain proofs. At least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# AES-256-GCM key for secrets at rest (refresh tokens, consumer secrets). 64 hex characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it makes every stored tenant credential unreadable — tenants must reconnect.
ENCRYPTION_KEY=

# Where the web app is served; used for email links and CORS. Required (https) in production.
WEB_ORIGIN=http://localhost:5173
# Only if the admin console is served from a different origin than WEB_ORIGIN.
ADMIN_WEB_ORIGIN=

# Tenants are served on <org slug>.<TENANT_BASE_DOMAIN> and <dealer slug>.<TENANT_BASE_DOMAIN>.
# Bare hostname, no scheme. Required in production.
TENANT_BASE_DOMAIN=localhost
# Host a tenant's custom domain must CNAME to (defaults to TENANT_BASE_DOMAIN).
CUSTOM_DOMAIN_TARGET=

# Number of reverse proxies in front of the API (defaults to 1 in production, 0 otherwise).
# Tenant resolution trusts X-Forwarded-Host/-For from exactly this many hops, so each proxy
# must OVERWRITE (never append client-supplied) X-Forwarded-Host and X-Forwarded-For.
TRUST_PROXY_HOPS=

# OAuth callbacks registered on each tenant's Salesforce Connected App. Required (https) in production.
SF_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/admin/auth/salesforce/callback
SF_ONBOARDING_REDIRECT_URI=http://localhost:3000/api/v1/onboarding/salesforce/callback

# Swagger UI at /api/docs. Defaults to on outside production.
ENABLE_API_DOCS=

# Optional: enables AI driving-licence verification at check-in. Without it that check reports 503
# and staff verify licences manually.
ANTHROPIC_API_KEY=

# "in-process" (default) runs the reminder/follow-up/host-sync schedulers inside a long-running
# server. "external" disables them and exposes POST /api/v1/internal/jobs/:job for an outside
# scheduler instead — required on serverless hosts (see .github/workflows/scheduled-jobs.yml).
SCHEDULER_MODE=
# Bearer secret for the job trigger endpoint. Required (at least 32 characters) when external.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JOB_TRIGGER_SECRET=

# Platform operator console (/platform): lists, reconnects and deletes tenants. Unset = disabled (404).
# Generate: printf %s "<password of 16+ characters>" | npm run -s platform:hash-password -w apps/api
PLATFORM_OPERATOR_PASSWORD_HASH=
